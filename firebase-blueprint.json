{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control (admin, user).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "CuratedRecipe": {
      "title": "CuratedRecipe",
      "description": "Culinary recipes managed by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "calories": { "type": "number" },
        "totalTime": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "createdBy"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global culinary assistant settings controlled by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "aiModel": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and RBAC role assignment."
    },
    "/curated_recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/CuratedRecipe" },
      "description": "Admin-curated featured recipes for all users."
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Administrator system settings."
    }
  }
}
